[0.016841, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.017807, "o", "╔══════════════════════════════════════════════════════════════╗\r\n║           SENTINEL AI v0.1.0 — DEMO                         ║\r\n║      Local-first AI Security Assistant                      ║\r\n╚══════════════════════════════════════════════════════════════╝\r\n"]
[1.019871, "o", "\r\n━━━ 1. ARCHITECTURE ━━━\r\n\r\n  Collectors → Event Bus → Rules → Correlation → Risk → Alerts → gRPC\r\n\r\n  7 collectors | 613 SigmaHQ rules | 14 plugins | 35 gRPC endpoints\r\n"]
[3.022162, "o", "\r\n━━━ 2. COLLECTORS ━━━\r\n\r\n"]
[3.024306, "o", "collectors/src/browser/    collectors/src/network/   collectors/src/startup/\r\ncollectors/src/file/\t   collectors/src/process/   collectors/src/usb/\r\ncollectors/src/framework/  collectors/src/registry/\r\n"]
[3.026677, "o", "\r\n  Process:  CN_PROC netlink (real-time kernel events)\r\n  Network:  /proc/net + inode→PID + DNS + scan detection\r\n  File:     fanotify + SHA256 + entropy + ransomware \r\n  Browser:  incremental SQLite + extension blocklist\r\n  USB:      /sys/bus/usb/devices polling\r\n  Registry: systemd user services\r\n"]
[3.027688, "o", "  Startup:  cron + systemd + shell profiles\r\n"]
[5.029704, "o", "\r\n"]
[5.029913, "o", "━━━ 3. PLUGINS (14) ━━━\r\n\r\n"]
[5.031315, "o", "plugins/abuseipdb/  plugins/home-assistant/  plugins/telegram/\r\nplugins/discord/    plugins/ioc/\t     plugins/urlhaus/\r\nplugins/email/\t    plugins/otx/\t     plugins/virustotal/\r\nplugins/geoip/\t    plugins/shodan/\r\nplugins/greynoise/  plugins/slack/\r\n"]
[5.031622, "o", "\r\n  Threat intel: AbuseIPDB, VirusTotal, Shodan, OTX, GreyNoise, URLhaus, GeoIP, IOC\r\n"]
[5.031704, "o", "  Notifications: Discord, Telegram, Slack, Email, Home Assistant\r\n"]
