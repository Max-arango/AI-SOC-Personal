[14.112993, "o", "  0 categorized by platform\r\n"]
[16.114471, "o", "\r\n━━━ 6. gRPC API (35/35) ━━━\r\n\r\n  Health    → GET  /status\r\n  Events    → POST /query_events\r\n  Alerts    → POST /list_alerts, /stream_alerts\r\n  Rules     → POST /create_rule, /test_rule\r\n"]
